.secrets
niri/.config/niri/local.kdl
# written by dms at runtime
gtk/.config/gtk-*/dank-colors.css
qt/.config/qt6ct/colors/
# per-machine display layout/scale (dms Display settings writes this)
niri/.config/niri/dms/outputs.kdl
# editor/tool backups
*.bak
# pkglist-snapshot temp files (renamed into place; only left if it crashed)
.snapshot.*
# never commit anything from ~/.ssh except the tracked config
ssh/.ssh/*
!ssh/.ssh/config

# not in git: kept in sync between machines by Syncthing (see syncthing/stignore)
docs/
private/
