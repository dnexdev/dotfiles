# Template: install.sh fills in @DOTS@ and @USER@ and installs it to /etc/pacman.d/hooks/,
# next to /usr/local/lib/dotfiles/pkglist-snapshot (from system/pkglist-snapshot).
# Don't symlink this file directly. The snapshot runs as @USER@, never as root.
[Trigger]
Operation = Install
Operation = Remove
Type = Package
Target = *

[Action]
Description = Updating dotfiles package lists...
When = PostTransaction
Exec = /usr/bin/runuser -u @USER@ -- /usr/local/lib/dotfiles/pkglist-snapshot @DOTS@
