# Template: install.sh fills in @DOTS@ and @USER@ and copies it to /etc/pacman.d/hooks/.
# Don't symlink this file directly.
[Trigger]
Operation = Install
Operation = Remove
Type = Package
Target = *

[Action]
Description = Updating dotfiles package lists...
When = PostTransaction
Exec = /bin/sh -c 'd=@DOTS@; h=$(uname -n); pacman -Qqen > $d/pkglist-$h.txt; pacman -Qqem > $d/aur-$h.txt; chown @USER@: $d/pkglist-$h.txt $d/aur-$h.txt'
