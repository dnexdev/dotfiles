// Syncthing ignore list for the "home" folder (all of ~), from dotfiles/syncthing/stignore.
// install.sh links ~/.stignore to this file. Everything NOT listed here is mirrored 1:1
// between the machines. Patterns starting with / match only at the top of ~; the others
// match at any depth. Why each group is here: docs/state-machines.md, M8.
// (?d) = Syncthing may delete it when it's in the way of removing a directory.

// ---- MUST stay ignored (correctness, not just space) ----

// Syncthing's own database and config: syncing them makes Syncthing rescan itself forever
/.local/state/syncthing
/.config/syncthing
// secrets and identities are per machine (each has its own ssh key; the dotfiles repo
// already shares ~/.ssh/config)
/.ssh
/.gnupg
/.pki
/.local/share/keyrings
/.local/share/pki
// the dotfiles repo is shared with git and has per-machine files inside it (pkglist-<host>,
// niri display layout); its configs reach ~ through stow symlinks, which sync as symlinks.
// Except its two gitignored parts, which only Syncthing shares: docs/ and private/ (private
// ssh settings etc.). The ! lines must come before /dotfiles/*: the first match wins.
!/dotfiles/docs
!/dotfiles/private
/dotfiles/*
/.dotfiles-backup
/.gitconfig.local
// browser profiles: copying one while the browser runs corrupts it (use the browser's sync)
/.zen
/.config/zen
/.mozilla
/.config/mozilla
/.config/chromium
/.config/google-chrome
/.config/BraveSoftware
// Evolution (GNOME mail/calendar): unused
/.config/evolution
/.local/share/evolution
// (Thunderbird's profile IS synced, on purpose: only run it on one machine at a time, or
// its databases get conflict copies)
// toolchains installed by SDK installers (x86_64 vs arm64 binaries), and the ESP-IDF
// checkout they come with (re-clone it: it's a 27k-file git repo)
/.espressif
/esp/esp-idf
// binary settings databases and session files that every running app rewrites
/.config/dconf
/.config/pulse
/.local/state
/.Xauthority
/.ICEauthority
/.xsession-errors*
/.local/share/recently-used.xbel
/.local/share/gvfs-metadata
/.local/share/Trash

// ---- programs built for one CPU: the Legion is x86_64, the M2 is arm64 ----

/.local/bin
/.local/lib
/.local/opt
/.local/share/nvim
/.local/share/pnpm
/.local/share/mise
/.local/share/uv
/.local/share/claude
/.local/share/cursor-agent
/.local/share/kiro-cli
/.local/share/opencode
/.cargo
/.rustup
/go
/.npm
/.bun
/.deno
/.nvm
/.pyenv
/.opencode
/.m2
/.gradle

// ---- caches and per-machine app state (rebuilt or re-downloaded on their own) ----

/.cache
/.var
/.steam
/.local/share/Steam
/.local/share/containers
/.local/share/flatpak
/.local/share/libvirt
/.ollama
/.nv
/.java
/.config/*/Cache
/.config/*/CachedData
/.config/*/Code Cache
/.config/*/GPUCache
/.config/*/DawnCache
/.config/*/Crash Reports
/.config/*/logs
// AI coding agents: live session state, rewritten constantly by every running session
/.claude
/.claude.json*
/.cursor
/.kiro
/.t3
// shell and REPL history: both machines append at once, so they would conflict constantly
/.zsh_history
/.histfile
/.bash_history
/.python_history
/.node_repl_history
/.lesshst
/.viminfo
/.wget-hsts
/.zcompdump*
/.sudo_as_admin_successful

// ---- anywhere in ~: build output and dependencies (rebuilt per machine) ----

target
build
dist
*.o
*.so
*.pyc
node_modules
.venv
venv
__pycache__
.direnv
.mise

// ---- anywhere: OS / editor junk ----

(?d).DS_Store
(?d)Thumbs.db
*.swp
