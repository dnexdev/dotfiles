# ~/.ssh/config, from dotfiles (stow package: ssh). This file is public.
# Private settings (user names, ...) live in ~/dotfiles/private/ssh_config: gitignored,
# synced between machines by Syncthing. Per-machine ones go in ~/.ssh/config.local.
# Both come first: for each setting ssh uses the first value it finds.
Include ~/dotfiles/private/ssh_config
Include config.local

# Machines, by Tailscale MagicDNS name, so these work from anywhere.
#   us  Legion, the always-on GPU box
#   m2  MacBook M2
Host us m2 dev
    User nex
    ServerAliveInterval 30
    ServerAliveCountMax 6

# The Legion, straight into a tmux session that survives disconnects.   ssh dev
Host dev
    HostName us
    RequestTTY yes
    RemoteCommand tmux new -A -s main

