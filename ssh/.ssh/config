# ~/.ssh/config, from dotfiles (stow package: ssh).
# Per-machine or private hosts go in ~/.ssh/config.local (not tracked).
Include config.local

# Machines, by Tailscale MagicDNS name, so these work from anywhere.
#   us  Legion, the always-on GPU box
#   m2  MacBook M2
Host us m2 dev
    User nex
    ServerAliveInterval 30
    ServerAliveCountMax 6

# The Legion, straight into a tmux session that survives disconnects.   ssh dev
Host dev
    HostName us
    RequestTTY yes
    RemoteCommand tmux new -A -s main

Host *
    AddKeysToAgent yes
